---
import { site } from '../../data/site';
import IconMenu from '../icons/IconMenu.astro';
import IconX from '../icons/IconX.astro';
import IconFileText from '../icons/IconFileText.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  class="fixed top-5 left-4 right-4 md:left-8 md:right-8 lg:left-10 lg:right-10 z-50 bg-[#121212]/60 backdrop-blur-md border border-white/10 rounded-xl"
  role="banner"
>
  <div class="px-4 md:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Left side: Site name & Controls -->
      <div class="flex items-center gap-4">
        <a
          href="/"
          class="text-xl font-bold text-white font-display hover:text-[var(--color-accent)] transition-colors no-underline"
          aria-label={`${site.name} — Home`}
        >
          {site.shortName || site.name}
        </a>

      </div>

      <!-- Right side: Desktop navigation -->
      <div class="hidden md:flex items-center gap-6">
        <nav class="flex items-center gap-6" aria-label="Main navigation">
          {site.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'text-sm font-semibold transition-colors no-underline',
                isActive(item.href)
                  ? 'text-[#F58A07]'
                  : 'text-white hover:text-[#F58A07]',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        
        <a
          href="/cv"
          class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold text-white bg-[#F58A07] rounded-md hover:bg-[#d97405] transition-colors no-underline"
        >
          <IconFileText size={16} />
          CV
        </a>
      </div>

      <!-- Mobile controls -->
      <div class="flex items-center gap-4 md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 rounded-md text-white hover:text-[#F58A07] transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <IconMenu size={24} class="menu-icon-open" />
          <IconX size={24} class="menu-icon-close hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/10 bg-[#121212]/90 backdrop-blur-md rounded-b-xl"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
  >
    <div class="px-4 py-4 space-y-2">
      <nav class="flex flex-col space-y-1" aria-label="Mobile navigation">
        {site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block px-3 py-2 text-base font-semibold rounded-md transition-colors no-underline',
              isActive(item.href)
                ? 'text-[#F58A07]'
                : 'text-white hover:text-[#F58A07]',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="pt-4 border-t border-white/10">
        <a
          href="/cv"
          class="inline-flex w-full justify-center items-center gap-2 px-4 py-2 text-base font-semibold text-white bg-[#F58A07] rounded-md hover:bg-[#d97405] transition-colors no-underline"
        >
          <IconFileText size={18} />
          View CV
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;

    const openIcon = button.querySelector('.menu-icon-open');
    const closeIcon = button.querySelector('.menu-icon-close');

    function toggleMenu(open?: boolean) {
      const isOpen = open ?? menu!.classList.contains('hidden');
      menu!.classList.toggle('hidden', !isOpen);
      button!.setAttribute('aria-expanded', String(isOpen));
      button!.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      openIcon?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);

      if (isOpen) {
        // Focus the first link in the menu
        const firstLink = menu!.querySelector('a');
        firstLink?.focus();
      }
    }

    button.addEventListener('click', () => toggleMenu());

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu!.classList.contains('hidden')) {
        toggleMenu(false);
        button.focus();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!menu!.classList.contains('hidden') && !menu!.contains(target) && !button.contains(target)) {
        toggleMenu(false);
      }
    });

    // Close on navigation (for SPA-like behavior)
    const links = menu.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
