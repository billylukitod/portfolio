---
import IconCalendar from '../icons/IconCalendar.astro';
import IconExternalLink from '../icons/IconExternalLink.astro';
import IconCode from '../icons/IconCode.astro';

interface Props {
  role: string;
  period: string;
  status: string;
  categories: string[];
  repositoryUrl?: string;
  liveUrl?: string;
}

const { role, period, status, categories, repositoryUrl, liveUrl } = Astro.props;

const statusColors: Record<string, string> = {
  completed: 'text-green-700 bg-green-50 border-green-200',
  ongoing: 'text-blue-700 bg-blue-50 border-blue-200',
  experiment: 'text-purple-700 bg-purple-50 border-purple-200',
};
---

<div
  class="p-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)]"
>
  <h3
    class="text-sm font-semibold text-[var(--color-text-secondary)] uppercase tracking-wider mb-4"
  >
    Project Details
  </h3>

  <dl class="space-y-4">
    <div>
      <dt class="text-xs font-medium text-[var(--color-text-muted)] uppercase tracking-wider">
        Role
      </dt>
      <dd class="mt-1 text-sm font-medium text-[var(--color-text-primary)]">{role}</dd>
    </div>

    <div>
      <dt class="text-xs font-medium text-[var(--color-text-muted)] uppercase tracking-wider">
        Period
      </dt>
      <dd class="mt-1 text-sm text-[var(--color-text-primary)] flex items-center gap-1.5">
        <IconCalendar size={14} />
        {period}
      </dd>
    </div>

    <div>
      <dt class="text-xs font-medium text-[var(--color-text-muted)] uppercase tracking-wider">
        Status
      </dt>
      <dd class="mt-1">
        <span
          class:list={[
            'inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full border capitalize',
            statusColors[status] || statusColors.completed,
          ]}
        >
          {status}
        </span>
      </dd>
    </div>

    <div>
      <dt class="text-xs font-medium text-[var(--color-text-muted)] uppercase tracking-wider">
        Categories
      </dt>
      <dd class="mt-1 flex flex-wrap gap-1.5">
        {
          categories.map((cat) => (
            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-surface-elevated)] text-[var(--color-text-secondary)] border border-[var(--color-border)]">
              {cat}
            </span>
          ))
        }
      </dd>
    </div>
  </dl>

  {
    (repositoryUrl || liveUrl) && (
      <div class="mt-5 pt-4 border-t border-[var(--color-border)] space-y-2">
        {repositoryUrl && (
          <a
            href={repositoryUrl}
            class="flex items-center gap-2 text-sm text-[var(--color-accent)] hover:underline no-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconCode size={14} />
            Source Code
            <IconExternalLink size={12} />
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            class="flex items-center gap-2 text-sm text-[var(--color-accent)] hover:underline no-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconExternalLink size={14} />
            Live Demo
          </a>
        )}
      </div>
    )
  }
</div>
