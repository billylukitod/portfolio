---
import TechnologyTags from './TechnologyTags.astro';
import IconArrowRight from '../icons/IconArrowRight.astro';

interface Props {
  title: string;
  slug: string;
  summary: string;
  year: string;
  role: string;
  coverImage: string;
  coverAlt: string;
  technologies: string[];
  featured?: boolean;
}

const { title, slug, summary, year, role, coverImage, coverAlt, technologies } = Astro.props;
---

<article class="group hover-lift">
  <a
    href={`/projects/${slug}`}
    class="block rounded-xl border border-gray-800 bg-[#121212] overflow-hidden hover:border-[var(--color-accent)] transition-all duration-300 no-underline h-full flex flex-col"
  >
    <div class="aspect-video overflow-hidden relative img-hover-zoom">
      <div class="absolute top-4 right-4 z-20">
        <span class="bg-white/90 backdrop-blur text-xs font-mono text-[#084887] px-3 py-1 rounded-full font-bold shadow-sm">
          {year}
        </span>
      </div>
      <img
        src={coverImage}
        alt={coverAlt}
        width="800"
        height="450"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 relative z-0"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-10 gradient-overlay pointer-events-none"></div>
    </div>
    <div class="p-6 flex-1 flex flex-col">
      <span class="text-xs font-medium text-[var(--color-accent)] mb-3 block uppercase tracking-wider">{role}</span>
      <h3
        class="text-xl font-bold text-white mb-3 group-hover:text-[var(--color-accent)] transition-colors"
      >
        {title}
      </h3>
      <p class="text-sm text-gray-400 mb-5 line-clamp-2 flex-1">{summary}</p>
      <TechnologyTags technologies={technologies.slice(0, 5)} />
    </div>
  </a>
</article>
