---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
  download?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
  download: isDownload = false,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center rounded-md font-semibold transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 no-underline group';

const variants: Record<string, string> = {
  primary: 'bg-[var(--color-accent)] text-white hover:bg-[#d97405]',
  secondary: 'border-2 border-white text-white hover:bg-[var(--color-accent)] hover:border-[var(--color-accent)]',
  ghost: 'hover:bg-[var(--color-surface-elevated)] text-[var(--color-text-secondary)] hover:text-white',
};

const sizes: Record<string, string> = {
  sm: 'h-9 px-3 text-sm gap-2',
  md: 'h-10 px-4 py-2 text-sm gap-2',
  lg: 'h-11 px-6 text-base gap-2',
};

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={[baseStyles, variants[variant], sizes[size], className]}
  download={isDownload || undefined}
  {...externalAttrs}
>
  <slot />
  {variant === 'secondary' && (
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-hover transition-transform duration-300 group-hover:rotate-45">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  )}
</a>
