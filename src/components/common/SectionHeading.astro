---
interface Props {
  eyebrow?: string;
  title: string;
  accentWord?: string;
  description?: string;
  class?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, accentWord, description, class: className = '', align = 'center' } = Astro.props;
---
<div class:list={[
  'mb-12',
  align === 'center' ? 'text-center' : 'text-left',
  className
]}>
  {eyebrow && (
    <span class="mb-2 block text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">
      {eyebrow}
    </span>
  )}
  <div class:list={[
    "flex items-center gap-4 mb-4 section-divider",
    align === 'center' ? 'justify-center' : 'justify-start'
  ]}>
    <div class="bar flex-1 h-[3px] bg-[var(--color-accent)] rounded-sm max-w-[100px]"></div>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold font-display text-white whitespace-nowrap">
      {title}{accentWord && <span class="text-[var(--color-accent)] ml-2">{accentWord}</span>}
    </h2>
    <div class="bar flex-1 h-[3px] bg-[var(--color-accent)] rounded-sm max-w-[100px]"></div>
  </div>
  {description && (
    <p class="max-w-2xl text-lg text-gray-400" class:list={[align === 'center' ? 'mx-auto' : '']}>
      {description}
    </p>
  )}
</div>
