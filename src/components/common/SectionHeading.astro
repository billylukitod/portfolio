---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, class: className = '', align = 'left' } = Astro.props;
---
<div class:list={[
  'mb-12',
  align === 'center' ? 'text-center' : 'text-left',
  className
]}>
  {eyebrow && (
    <span class="mb-2 block text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">
      {eyebrow}
    </span>
  )}
  <h2 class="mb-4 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
    {title}
  </h2>
  {description && (
    <p class="max-w-2xl text-lg text-[var(--color-text-muted)]" class:list={[align === 'center' ? 'mx-auto' : '']}>
      {description}
    </p>
  )}
</div>
