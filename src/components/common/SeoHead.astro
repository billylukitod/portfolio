---
import { site } from '../../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  image = site.seo.defaultImage,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site || site.siteUrl).href,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title
  ? site.seo.titleTemplate.replace('%s', title)
  : site.seo.defaultTitle;
const imageUrl = new URL(image, Astro.site || site.siteUrl).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{site.seo.twitterHandle && <meta name="twitter:creator" content={site.seo.twitterHandle} />}

<!-- JSON-LD -->
{jsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
