---
interface Props {
  class?: string;
  size?: number;
  'aria-hidden'?: boolean;
}

const { class: className = '', size = 24, 'aria-hidden': ariaHidden = true } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden}
>
  <path d="M18 6 6 18" />
  <path d="m6 6 12 12" />
</svg>
