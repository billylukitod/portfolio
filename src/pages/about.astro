---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import ButtonLink from '../components/common/ButtonLink.astro';
import TechnologyTags from '../components/projects/TechnologyTags.astro';
import { site } from '../data/site';
import { experiences } from '../data/experience';
import { skillGroups } from '../data/skills';
import { achievements, education } from '../data/achievements';
---

<BaseLayout title="About" description={`About ${site.name} — ${site.title}`}>
  <!-- Page header -->
  <section class="py-[var(--spacing-section-sm)] md:py-[var(--spacing-section)] bg-[var(--color-surface)]">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
        <div class="md:col-span-5 flex flex-col items-center animate-hero-image relative">
          <!-- Background glow and ornaments -->
          <div class="absolute top-10 -left-8 w-32 h-32 bg-[var(--color-accent)] opacity-10 dark:opacity-20 rounded-full blur-2xl -z-10"></div>
          <div class="absolute bottom-20 -right-4 w-40 h-40 bg-[var(--color-accent-light)] opacity-20 dark:opacity-10 rounded-full blur-3xl -z-10"></div>
          
          <svg class="absolute top-1/4 -right-6 text-[var(--color-accent)] opacity-40 w-12 h-12 -z-10 rotate-12" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4">
            <rect x="20" y="20" width="60" height="60" rx="8" />
            <circle cx="50" cy="50" r="10" />
            <path d="M50 10 L50 20 M90 50 L80 50 M50 90 L50 80 M10 50 L20 50" stroke-linecap="round" />
          </svg>
          
          <div class="absolute bottom-32 -left-4 flex gap-2 opacity-50 -z-10">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-text-muted)]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-text-muted)]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-text-muted)]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-text-muted)]"></span>
          </div>
          
          <div class="relative w-full max-w-sm mx-auto mb-4">
            <img
              src="/media/profile/photo.png"
              alt={`${site.name} profile photo`}
              width="1024"
              height="876"
              class="w-full h-auto object-cover object-top"
              style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%);"
              loading="eager"
            />
          </div>
          <div class="flex flex-col sm:flex-row gap-3 w-full max-w-sm animate-hero-cta z-10 relative">
            <ButtonLink href="/projects" variant="primary" class="justify-center flex-1">View Projects</ButtonLink>
            <ButtonLink href="/contact" variant="secondary" class="justify-center flex-1">Get in Touch</ButtonLink>
          </div>
        </div>

        <div class="md:col-span-7 space-y-8 z-10 relative">
          <div class="animate-hero-eyebrow">
            <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-text-primary)] mb-2 font-display">About Me</h1>
            <p class="text-[var(--color-accent)] font-medium">{site.title}</p>
          </div>

          <div class="animate-hero-summary space-y-4 text-[var(--color-text-secondary)] leading-relaxed text-lg">
            {site.aboutBio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="animate-on-scroll">
            <h2 class="text-xl font-semibold text-[var(--color-text-primary)] mb-3">Engineering Philosophy</h2>
            <p class="text-[var(--color-text-secondary)] leading-relaxed">{site.aboutPhilosophy}</p>
          </div>

          <div class="animate-on-scroll">
            <h2 class="text-xl font-semibold text-[var(--color-text-primary)] mb-3">Current Interests</h2>
            <p class="text-[var(--color-text-secondary)] leading-relaxed">{site.aboutInterests}</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Experience -->
  <section id="experience" class="py-[var(--spacing-section-sm)] md:py-[var(--spacing-section)]">
    <Container>
      <div class="animate-on-scroll">
        <SectionHeading title="Experience" />
      </div>
      <div class="mt-10 max-w-3xl space-y-8 stagger-children">
        {experiences.map((exp) => (
          <div class="hover-lift flex flex-col md:flex-row gap-4 md:gap-8 p-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)]">
            <div class="md:w-1/4 shrink-0">
              <p class="text-sm text-[var(--color-text-muted)] font-mono">{exp.period}</p>
            </div>
            <div class="md:w-3/4">
              <h3 class="text-lg font-bold text-[var(--color-text-primary)]">{exp.role}</h3>
              <p class="text-[var(--color-accent)] font-medium mb-2">{exp.organization}</p>
              <ul class="text-[var(--color-text-secondary)] list-disc list-outside ml-4 space-y-2">
                {exp.description.map((item) => (
                  <li class="leading-relaxed">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Education & Achievements -->
  <section class="py-[var(--spacing-section-sm)] md:py-[var(--spacing-section)] bg-[var(--color-surface)]">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="animate-on-scroll">
          <SectionHeading title="Education" />
          <div class="mt-8 space-y-6">
            {education.map((edu) => (
              <div class="hover-lift p-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg)]">
                <h3 class="text-lg font-bold text-[var(--color-text-primary)]">{edu.degree}</h3>
                <p class="text-[var(--color-accent)] font-medium">{edu.institution}</p>
                <p class="text-sm text-[var(--color-text-muted)] font-mono mt-1">{edu.period}</p>
                {edu.description && (
                  <p class="text-[var(--color-text-secondary)] mt-2 text-sm">{edu.description}</p>
                )}
              </div>
            ))}
          </div>
        </div>

        <div class="animate-on-scroll">
          <SectionHeading title="Achievements" />
          <div class="mt-8 space-y-6">
            {achievements.map((achievement) => (
              <div class="hover-lift p-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg)]">
                <h3 class="text-lg font-bold text-[var(--color-text-primary)]">{achievement.title}</h3>
                {achievement.event && (
                  <p class="text-[var(--color-accent)] font-medium">{achievement.event}</p>
                )}
                <p class="text-sm text-[var(--color-text-muted)] font-mono mt-1">{achievement.year}</p>
                <p class="text-[var(--color-text-secondary)] mt-2 text-sm">{achievement.description}</p>
                {achievement.certificateUrl && (
                  <div class="mt-4">
                    <a href={achievement.certificateUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full bg-[var(--color-surface-elevated)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/30 hover:bg-[var(--color-accent)]/5 transition-all shadow-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                        <path d="m9 12 2 2 4-4"/>
                      </svg>
                      View Certificate
                    </a>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Skills -->
  <section class="py-[var(--spacing-section-sm)] md:py-[var(--spacing-section)]">
    <Container>
      <div class="animate-on-scroll">
        <SectionHeading title="Skills & Tools" />
      </div>

      {/* Core */}
      <div class="mt-10 animate-on-scroll">
        <div class="flex items-center gap-3 mb-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] border border-[var(--color-accent)]/20">Core</span>
          <span class="text-sm text-[var(--color-text-muted)]">Technologies I've built multiple projects with</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
          {skillGroups.filter(g => g.level === 'core').map((group) => (
            <div class="hover-lift p-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)]">
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)] mb-4">{group.category}</h3>
              <TechnologyTags technologies={group.skills} />
            </div>
          ))}
        </div>
      </div>

      {/* Working Knowledge */}
      <div class="mt-10 animate-on-scroll">
        <div class="flex items-center gap-3 mb-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">Working Knowledge</span>
          <span class="text-sm text-[var(--color-text-muted)]">Used meaningfully in specific projects</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
          {skillGroups.filter(g => g.level === 'working').map((group) => (
            <div class="hover-lift p-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)]">
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)] mb-4">{group.category}</h3>
              <TechnologyTags technologies={group.skills} />
            </div>
          ))}
        </div>
      </div>

      {/* Familiar */}
      <div class="mt-10 animate-on-scroll">
        <div class="flex items-center gap-3 mb-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20">Familiar</span>
          <span class="text-sm text-[var(--color-text-muted)]">Currently exploring and building proficiency</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
          {skillGroups.filter(g => g.level === 'familiar').map((group) => (
            <div class="hover-lift p-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)]">
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)] mb-4">{group.category}</h3>
              <TechnologyTags technologies={group.skills} />
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-[var(--spacing-section)] bg-[var(--color-surface)] text-center">
    <Container>
      <div class="animate-on-scroll max-w-xl mx-auto">
        <h2 class="font-display text-2xl font-bold text-[var(--color-text-primary)] mb-4">Want to work together?</h2>
        <p class="text-[var(--color-text-secondary)] mb-8">
          Check out my projects or get in touch to discuss engineering roles, research, and collaboration.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <ButtonLink href="/projects" variant="primary">View Projects</ButtonLink>
          <ButtonLink href="/contact" variant="secondary">Contact Me</ButtonLink>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
