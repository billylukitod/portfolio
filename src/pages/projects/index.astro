---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const sortedProjects = projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="Projects" description="Engineering projects spanning robotics, embedded systems, UAV, and control systems.">
  <section class="pt-32 pb-[var(--spacing-section-sm)] md:pb-[var(--spacing-section)] bg-[#0a0a0a] min-h-screen">
    <Container>
      <div class="mb-16 animate-hero-heading flex flex-col items-center text-center">
        <h1 class="text-5xl md:text-6xl font-black text-white mb-6 font-display uppercase tracking-tight">
          <span class="sr-only">Billy Lukito Danuharja &mdash; </span>
          Selected <span class="text-[var(--color-accent)]">Engineering Projects</span>
        </h1>
        <div class="flex items-center gap-4 mb-6">
          <div class="h-1 w-12 bg-[var(--color-accent)]"></div>
          <div class="h-2 w-2 rounded-full bg-[var(--color-accent)]"></div>
          <div class="h-1 w-12 bg-[var(--color-accent)]"></div>
        </div>
        <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl animate-hero-summary font-light">
          Engineering projects spanning robotics, embedded systems, electronics, and control systems.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {sortedProjects.map((project) => (
          <div class="hover-lift">
            <ProjectCard
              title={project.data.title}
              slug={project.id}
              summary={project.data.summary}
              year={project.data.year}
              role={project.data.role}
              coverImage={project.data.coverImage}
              coverAlt={project.data.coverAlt}
              technologies={project.data.technologies}
              featured={project.data.featured}
            />
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
