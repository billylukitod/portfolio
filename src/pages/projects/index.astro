---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const sortedProjects = projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="Projects" description="Engineering projects spanning robotics, embedded systems, UAV, and control systems.">
  <section class="py-[var(--spacing-section-sm)] md:py-[var(--spacing-section)]">
    <Container>
      <div class="mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-text-primary)] mb-4">Projects</h1>
        <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl">
          Selected work spanning robotics, embedded systems, electronics, and control systems.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={project.id}
            summary={project.data.summary}
            year={project.data.year}
            role={project.data.role}
            coverImage={project.data.coverImage}
            coverAlt={project.data.coverAlt}
            technologies={project.data.technologies}
            featured={project.data.featured}
          />
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
