---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import ButtonLink from '../components/common/ButtonLink.astro';
import IconDownload from '../components/icons/IconDownload.astro';
import IconArrowLeft from '../components/icons/IconArrowLeft.astro';
import { site } from '../data/site';
---

<BaseLayout title="Curriculum Vitae" description={`View and download ${site.name}'s CV`}>
  <section class="py-[var(--spacing-section-sm)] md:py-[var(--spacing-section)] bg-[var(--color-surface)]">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 animate-hero-heading">
          <div>
            <a
              href="/"
              class="inline-flex items-center gap-2 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors mb-4 no-underline"
            >
              <IconArrowLeft size={16} />
              Back to Home
            </a>
            <h1 class="font-display text-3xl md:text-4xl font-bold text-[var(--color-text-primary)]">
              Curriculum Vitae
            </h1>
          </div>
          <a
            href={site.cvPath}
            download
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-[var(--color-accent)] text-[var(--color-accent-contrast)] font-medium rounded-[var(--radius-md)] hover:bg-[var(--color-accent-hover)] transition-colors no-underline hover-lift"
          >
            <IconDownload size={18} />
            Download PDF
          </a>
        </div>

        <div class="rounded-[var(--radius-xl)] overflow-hidden border border-[var(--color-border)] shadow-md bg-[var(--color-surface-elevated)] h-[80vh] min-h-[600px] animate-on-scroll">
          <object
            data={site.cvPath}
            type="application/pdf"
            width="100%"
            height="100%"
            class="w-full h-full"
          >
            <div class="flex flex-col items-center justify-center h-full p-8 text-center bg-[var(--color-surface)]">
              <p class="text-lg font-medium text-[var(--color-text-primary)] mb-2">PDF Viewer Not Available</p>
              <p class="text-[var(--color-text-secondary)] mb-6">
                Your browser or device doesn't support built-in PDF viewing.
              </p>
              <a
                href={site.cvPath}
                download
                class="inline-flex items-center gap-2 px-6 py-2.5 bg-[var(--color-accent)] text-[var(--color-accent-contrast)] font-medium rounded-[var(--radius-md)] hover:bg-[var(--color-accent-hover)] transition-colors no-underline"
              >
                <IconDownload size={18} />
                Download CV Instead
              </a>
            </div>
          </object>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
