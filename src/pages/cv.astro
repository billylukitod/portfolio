---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import IconDownload from '../components/icons/IconDownload.astro';
import IconArrowLeft from '../components/icons/IconArrowLeft.astro';
import { site } from '../data/site';
---

<BaseLayout title="Curriculum Vitae" description={`View and download ${site.name}'s CV`}>
  <section class="pt-32 pb-[var(--spacing-section-sm)] md:pb-[var(--spacing-section)] bg-[#0a0a0a] min-h-screen">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="mb-10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 animate-hero-heading border-b border-[#222] pb-6">
          <div>
            <a
              href="/"
              class="inline-flex items-center gap-2 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors mb-4 no-underline uppercase tracking-widest font-bold group"
            >
              <IconArrowLeft size={16} class="transition-transform group-hover:-translate-x-1" />
              Back to Home
            </a>
            <h1 class="font-display text-4xl md:text-5xl font-black text-white uppercase tracking-tight">
              Curriculum <span class="text-[var(--color-accent)]">Vitae</span>
            </h1>
          </div>
          <a
            href={site.cvPath}
            download
            class="inline-flex items-center gap-3 px-6 py-3 border border-[var(--color-accent)] bg-transparent text-[var(--color-accent)] font-bold uppercase tracking-wider text-sm rounded-none hover:bg-[var(--color-accent)] hover:text-[#0a0a0a] transition-colors no-underline hover-lift group"
          >
            <IconDownload size={18} class="group-hover:animate-bounce" />
            Download PDF
          </a>
        </div>

        <div class="rounded-xl overflow-hidden border border-[#333] shadow-[0_0_30px_rgba(245,138,7,0.1)] bg-[#121212] h-[80vh] min-h-[600px] animate-on-scroll relative">
          <div class="absolute inset-0 bg-[var(--color-accent)] opacity-5 blur-3xl pointer-events-none"></div>
          <object
            data={site.cvPath}
            type="application/pdf"
            width="100%"
            height="100%"
            class="w-full h-full relative z-10"
          >
            <div class="flex flex-col items-center justify-center h-full p-8 text-center bg-[#121212]">
              <p class="text-xl font-bold text-white mb-3">PDF Viewer Not Available</p>
              <p class="text-[var(--color-text-secondary)] mb-8 font-light max-w-md">
                Your browser or device doesn't support built-in PDF viewing.
              </p>
              <a
                href={site.cvPath}
                download
                class="inline-flex items-center gap-3 px-8 py-4 bg-[var(--color-accent)] text-[#0a0a0a] font-bold uppercase tracking-wider rounded hover:bg-[var(--color-accent)]/80 transition-colors no-underline"
              >
                <IconDownload size={20} />
                Download CV Instead
              </a>
            </div>
          </object>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
