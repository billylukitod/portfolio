---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import ButtonLink from '../components/common/ButtonLink.astro';
import SocialLinks from '../components/common/SocialLinks.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import IconArrowRight from '../components/icons/IconArrowRight.astro';
import IconMail from '../components/icons/IconMail.astro';
import IconLinkedin from '../components/icons/IconLinkedin.astro';
import { site } from '../data/site';
import { experiences } from '../data/experience';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const focusAreas = [
  {
    title: 'Robotics & Autonomy',
    description: 'ROS, Gazebo, SLAM, navigation, LiDAR, Ackermann systems. Building robust autonomous behaviors and simulation environments.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-[var(--color-accent)] mb-2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>',
  },
  {
    title: 'Embedded & Electronics',
    description: 'STM32, ESP32, FreeRTOS, PCB design, sensors, debugging. Developing reliable firmware and hardware architectures.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-[var(--color-accent)] mb-2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>',
  },
  {
    title: 'Control & Integration',
    description: 'Fuzzy logic, PSO, control systems, system integration, testing. Bridging algorithms and physical execution.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-[var(--color-accent)] mb-2"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>',
  },
];
---

<BaseLayout title={site.seo.defaultTitle} description={site.description}>
  <!-- 1. Hero Section -->
  <section class="pt-[120px] pb-[var(--spacing-section)] md:pb-[calc(var(--spacing-section)*1.5)] px-4">
    <div class="relative w-full min-h-[600px] md:min-h-[800px] rounded-2xl overflow-hidden flex items-center justify-center mx-auto max-w-7xl">
      <!-- Background Image -->
      <img
        src="/media/hero.png"
        alt="Engineering background"
        class="absolute inset-0 w-full h-full object-cover opacity-35"
        loading="eager"
      />
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/90 via-[#0a0a0a]/60 to-[#0a0a0a]/30 gradient-overlay"></div>
      
      <!-- Content Overlay -->
      <div class="relative z-10 flex flex-col items-center text-center px-4 max-w-4xl mx-auto">
        <!-- Semantic SEO Structure: H1 (Name), P (Profession), H2 (Headline) -->
        <div class="animate-hero-eyebrow flex flex-col items-center gap-3 mb-8">
          <h1 class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/50">
            <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent)] pulse-dot"></span>
            <span class="text-sm font-medium tracking-wide text-white uppercase">{site.name}</span>
          </h1>
          <p class="text-sm md:text-base font-semibold tracking-widest text-[#F58A07] uppercase">
            {site.title}
          </p>
        </div>
        
        <!-- Headline -->
        <h2 
          class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-tight text-white mb-6 animate-hero-heading"
          set:html={site.headline}
        >
        </h2>
        
        <p class="text-xl md:text-2xl text-gray-300 max-w-2xl leading-relaxed mb-8 animate-hero-summary">
          {site.summary}
        </p>
        
        <div class="flex items-center justify-center gap-2 mb-10 text-gray-300 font-medium animate-hero-status">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#F58A07]"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{site.location} &middot; {site.availability}</span>
        </div>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 animate-hero-cta">
          <a href={site.heroCtaPrimary.href} class="group inline-flex items-center gap-3 px-8 py-4 border-2 border-[#F58A07] text-white hover:bg-[#F58A07] hover:text-black transition-colors rounded-none font-bold text-lg">
            {site.heroCtaPrimary.label}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-45 transition-transform duration-300 arrow-hover"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="12 5 19 5 19 12"></polyline></svg>
          </a>
          <a href={site.heroCtaSecondary.href} class="group inline-flex items-center gap-3 px-8 py-4 border-2 border-gray-700 text-white hover:bg-gray-800 transition-colors rounded-none font-bold text-lg">
            {site.heroCtaSecondary.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Engineering Focus -->
  <section class="py-[var(--spacing-section)] bg-[var(--color-bg)] relative overflow-hidden">
    <!-- Ambient glowing background like before -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[var(--color-accent)]/10 blur-[120px] rounded-full pointer-events-none z-0"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#084887]/20 blur-[100px] rounded-full pointer-events-none z-0"></div>
    
    <Container class="relative z-10">
      <div class="animate-on-scroll flex flex-col items-center text-center mb-12">
        <div class="flex items-center justify-center gap-4 section-divider">
          <div class="h-1 w-12 bg-[#F58A07] bar"></div>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white">Engineering Focus</h2>
          <div class="h-1 w-12 bg-[#F58A07] bar"></div>
        </div>
      </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger-children relative z-10">
          {focusAreas.map((area) => (
            <div class="hover-lift rounded-none p-8 bg-[var(--color-surface)] border border-gray-800 border-t-4 border-t-[#F58A07] transition-all relative z-10">
              <div class="block" aria-hidden="true" set:html={area.icon} />
            <h3 class="text-2xl font-bold text-white mb-3">{area.title}</h3>
            <p class="text-gray-400 leading-relaxed">{area.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 3. Featured Projects -->
  <section class="py-[var(--spacing-section)] bg-[var(--color-surface)]">
    <Container>
      <div class="animate-on-scroll flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div class="flex items-center gap-4 section-divider">
          <div class="h-1 w-12 bg-[#F58A07] bar"></div>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white">Featured Projects</h2>
        </div>
        <a href="/projects" class="group inline-flex items-center gap-2 text-[#F58A07] font-bold text-lg uppercase tracking-wider accent-underline">
          All Projects
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-45 transition-transform duration-300 arrow-hover"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="12 5 19 5 19 12"></polyline></svg>
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {featuredProjects.map((project) => (
          <div class="hover-lift">
            <ProjectCard
              title={project.data.title}
              slug={project.id}
              summary={project.data.summary}
              year={project.data.year}
              role={project.data.role}
              coverImage={project.data.coverImage}
              coverAlt={project.data.coverAlt}
              technologies={project.data.technologies}
              featured={project.data.featured}
            />
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 4. About Preview -->
  <section class="py-[var(--spacing-section)] relative overflow-hidden bg-[var(--color-bg)] border-y border-gray-900/50">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/media/about-action.jpg" 
        alt="Billy Lukito Danuharja working on an embedded systems prototype" 
        class="w-full h-full object-cover opacity-50 grayscale"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)] via-[var(--color-bg)]/40 to-[var(--color-bg)]"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg)] via-transparent to-[var(--color-bg)]"></div>
    </div>

    <Container class="relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center animate-on-scroll">
        <div class="relative group order-last lg:order-first max-w-md mx-auto lg:max-w-none">
          <div class="absolute inset-0 border-4 border-[#084887] translate-x-4 translate-y-4 z-0 transition-transform duration-300 group-hover:translate-x-6 group-hover:translate-y-6"></div>
          <img 
            src="/media/profile/photo.png" 
            alt={site.name} 
            class="relative z-10 w-full h-auto object-cover border border-gray-800 img-hover-zoom bg-gray-900"
          />
        </div>
        <div class="flex flex-col z-10">
          <div class="flex items-center gap-4 mb-8 section-divider">
            <div class="h-1 w-12 bg-[#F58A07] bar"></div>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-white">About Me</h2>
          </div>
          <div class="text-gray-300 text-lg space-y-4 mb-10 leading-relaxed drop-shadow-md">
            {site.aboutBio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <div>
            <a href="/about" class="group inline-flex items-center gap-3 px-8 py-4 border-2 border-[#084887] text-white hover:bg-[#084887] transition-colors rounded-none font-bold text-lg bg-[#0a0a0a]/50 backdrop-blur-sm">
              More About Me
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-45 transition-transform duration-300 arrow-hover"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="12 5 19 5 19 12"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Experience Section -->
  <section class="py-[var(--spacing-section)] bg-[var(--color-surface)]">
    <Container>
      <div class="animate-on-scroll flex flex-col items-center text-center mb-16">
        <div class="flex items-center justify-center gap-4 section-divider">
          <div class="h-1 w-12 bg-[#F58A07] bar"></div>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white">Experience</h2>
          <div class="h-1 w-12 bg-[#F58A07] bar"></div>
        </div>
      </div>
      
      <div class="max-w-4xl mx-auto relative border-l-2 border-[#084887] ml-4 md:ml-auto md:border-l-0">
        <!-- MD: Center line -->
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-[#084887] -translate-x-1/2"></div>
        
        <div class="space-y-12 stagger-children">
          {experiences.slice(0, 3).map((exp, i) => (
            <div class="relative flex flex-col md:flex-row md:justify-between md:items-center w-full group pl-8 md:pl-0">
              <!-- Dot -->
              <div class={`absolute left-[-9px] md:left-1/2 md:-translate-x-1/2 top-0 md:top-1/2 md:-translate-y-1/2 w-4 h-4 rounded-full bg-[#F58A07] ring-4 ring-[var(--color-surface)] z-10 ${i === 0 ? 'pulse-dot' : ''}`}></div>
              
              <!-- Content Left/Right based on index -->
              <div class={`md:w-5/12 ${i % 2 === 0 ? 'md:text-right md:pr-12' : 'md:order-last md:text-left md:pl-12'}`}>
                <h3 class="text-2xl font-bold text-white mb-1 group-hover:text-[#F58A07] transition-colors">{exp.role}</h3>
                <p class="text-lg text-gray-400 font-medium mb-4">{exp.organization}</p>
                <div class="md:hidden text-[#F58A07] font-bold font-mono mb-4">{exp.period}</div>
                <ul class="text-gray-400 leading-relaxed space-y-3 mt-4">
                  {exp.description.map((item) => (
                    <li class={`flex items-start gap-3 ${i % 2 === 0 ? 'md:flex-row-reverse md:text-right text-left' : 'text-left'}`}>
                      <span class="text-[#F58A07] mt-1.5 flex-shrink-0 text-xs">●</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              
              <!-- Date (Center-ish) -->
              <div class={`hidden md:block md:w-5/12 ${i % 2 === 0 ? 'md:order-last md:text-left md:pl-12' : 'md:text-right md:pr-12'}`}>
                <span class="text-[#F58A07] font-bold font-mono text-xl">{exp.period}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- 6. Contact CTA Section -->
  <section class="py-[var(--spacing-section)] bg-[var(--color-bg)] border-t border-gray-900">
    <Container>
      <div class="animate-on-scroll max-w-3xl mx-auto flex flex-col items-center text-center">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-white mb-6">
          {site.contactCta.heading}
        </h2>
        <p class="text-xl text-gray-400 mb-12 leading-relaxed">
          {site.contactCta.body}
        </p>
        <div class="flex flex-col sm:flex-row gap-6 w-full sm:w-auto">
          <a href={`mailto:${site.email}`} class="group inline-flex items-center justify-center gap-3 px-8 py-4 border-2 border-[#F58A07] text-white hover:bg-[#F58A07] hover:text-black transition-colors rounded-none font-bold text-lg w-full sm:w-auto">
            <IconMail size={20} class="mr-2" />
            {site.contactCta.emailLabel}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-45 transition-transform duration-300 arrow-hover"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="12 5 19 5 19 12"></polyline></svg>
          </a>
          <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center gap-3 px-8 py-4 border-2 border-[#084887] text-white hover:bg-[#084887] transition-colors rounded-none font-bold text-lg w-full sm:w-auto">
            <IconLinkedin size={20} class="mr-2" />
            {site.contactCta.linkedinLabel}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-45 transition-transform duration-300 arrow-hover"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="12 5 19 5 19 12"></polyline></svg>
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

