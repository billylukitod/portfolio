---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import NoteCard from '../../components/notes/NoteCard.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/dates';

const notes = await getCollection('notes', ({ data }) => !data.draft);
const sortedNotes = notes.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Notes" description="Technical notes on robotics, embedded systems, and engineering.">
  <section class="pt-32 pb-[var(--spacing-section-sm)] md:pb-[var(--spacing-section)] bg-[#0a0a0a] min-h-screen">
    <Container>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-16 border-b border-[#222] pb-8">
        <div class="animate-hero-heading">
          <h1 class="text-5xl md:text-6xl font-black text-white mb-4 font-display uppercase tracking-tight">
            Technical <span class="text-[var(--color-accent)]">Notes</span>
          </h1>
          <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl animate-hero-summary font-light border-l-4 border-[#084887] pl-4">
            Thoughts and tutorials on robotics, embedded systems, and engineering.
          </p>
        </div>
      </div>

      {sortedNotes.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
          {sortedNotes.map((note) => (
            <div class="hover-lift border-l-4 border-l-[var(--color-accent)] rounded-r-[var(--radius-lg)] overflow-hidden bg-[#121212] border-y border-r border-[#222]">
              <NoteCard
                title={note.data.title}
                slug={note.id}
                summary={note.data.summary}
                publishedAt={note.data.publishedAt}
                tags={note.data.tags}
                readingTime={getReadingTime(note.body ?? '')}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 bg-[#121212] rounded-2xl border border-[#222]">
          <p class="text-[var(--color-text-muted)] text-lg">No notes published yet. Check back later.</p>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
