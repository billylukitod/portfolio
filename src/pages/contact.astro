---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import ButtonLink from '../components/common/ButtonLink.astro';
import IconMail from '../components/icons/IconMail.astro';
import IconLinkedin from '../components/icons/IconLinkedin.astro';
import IconGithub from '../components/icons/IconGithub.astro';
import IconMapPin from '../components/icons/IconMapPin.astro';
import IconFileText from '../components/icons/IconFileText.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Get in touch for engineering roles, research collaboration, and technical projects.">
  <section class="pt-32 pb-[var(--spacing-section-sm)] md:pb-[var(--spacing-section)] bg-[#0a0a0a] min-h-screen flex flex-col justify-center">
    <Container>
      <div class="max-w-3xl mx-auto">
        <h1 class="animate-hero-heading font-display text-5xl md:text-7xl font-black text-white mb-6 text-center uppercase tracking-tighter">
          Let's <span class="text-[var(--color-accent)]">Connect</span>
        </h1>

        <div class="text-center mb-16 animate-hero-summary">
          <p class="text-xl text-[var(--color-text-secondary)] leading-relaxed mb-4 font-light">
            {site.availability}
          </p>
          <p class="text-[#084887] font-semibold flex items-center justify-center gap-2 text-lg">
            <IconMapPin size={20} />
            {site.location}
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-16 stagger-children">
          <a
            href={`mailto:${site.email}`}
            class="hover-lift flex items-center gap-4 p-6 rounded-2xl border border-[#222] bg-[#121212] hover:border-[var(--color-accent)] transition-all duration-300 no-underline group"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center group-hover:bg-[var(--color-accent)] transition-colors duration-300">
              <IconMail size={24} class="text-[var(--color-accent)] group-hover:text-[#0a0a0a] transition-colors" />
            </div>
            <div class="flex-grow">
              <div class="text-lg font-bold text-white">{site.contactCta.emailLabel}</div>
              <div class="text-sm text-[var(--color-text-muted)] group-hover:text-white transition-colors">{site.email}</div>
            </div>
            <div class="text-[var(--color-accent)] transition-transform duration-300 group-hover:rotate-45">↗</div>
          </a>

          <a
            href={site.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover-lift flex items-center gap-4 p-6 rounded-2xl border border-[#222] bg-[#121212] hover:border-[#084887] transition-all duration-300 no-underline group"
          >
            <div class="w-12 h-12 rounded-xl bg-[#084887]/10 flex items-center justify-center group-hover:bg-[#084887] transition-colors duration-300">
              <IconLinkedin size={24} class="text-[#084887] group-hover:text-white transition-colors" />
            </div>
            <div class="flex-grow">
              <div class="text-lg font-bold text-white">{site.contactCta.linkedinLabel}</div>
              <div class="text-sm text-[var(--color-text-muted)] group-hover:text-white transition-colors">LinkedIn Profile</div>
            </div>
            <div class="text-[#084887] transition-transform duration-300 group-hover:rotate-45">↗</div>
          </a>

          <a
            href={site.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover-lift flex items-center gap-4 p-6 rounded-2xl border border-[#222] bg-[#121212] hover:border-white transition-all duration-300 no-underline group"
          >
            <div class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center group-hover:bg-white transition-colors duration-300">
              <IconGithub size={24} class="text-white/70 group-hover:text-[#0a0a0a] transition-colors" />
            </div>
            <div class="flex-grow">
              <div class="text-lg font-bold text-white">GitHub</div>
              <div class="text-sm text-[var(--color-text-muted)] group-hover:text-white transition-colors">Open Source</div>
            </div>
            <div class="text-white/70 transition-transform duration-300 group-hover:rotate-45">↗</div>
          </a>

          <a
            href="/cv"
            class="hover-lift flex items-center gap-4 p-6 rounded-2xl border border-[#222] bg-[#121212] hover:border-[var(--color-accent)] transition-all duration-300 no-underline group"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center group-hover:bg-[var(--color-accent)] transition-colors duration-300">
              <IconFileText size={24} class="text-[var(--color-accent)] group-hover:text-[#0a0a0a] transition-colors" />
            </div>
            <div class="flex-grow">
              <div class="text-lg font-bold text-white">View CV</div>
              <div class="text-sm text-[var(--color-text-muted)] group-hover:text-white transition-colors">Preview & Download</div>
            </div>
            <div class="text-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-1">→</div>
          </a>
        </div>

        <div class="animate-on-scroll text-center p-10 rounded-3xl bg-[#121212] border border-[#222] relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-accent)]/5 to-transparent pointer-events-none"></div>
          <h2 class="text-2xl font-black text-white mb-4 uppercase tracking-wide">
            {site.contactCta.heading}
          </h2>
          <p class="text-[var(--color-text-secondary)] mb-8 text-lg font-light max-w-xl mx-auto">
            {site.contactCta.body}
          </p>
          <ButtonLink href={`mailto:${site.email}`} variant="primary" class="border border-[var(--color-accent)] bg-[var(--color-accent)] text-[#0a0a0a] hover:bg-transparent hover:text-[var(--color-accent)] text-lg px-8 py-3">
            <IconMail size={20} class="mr-2" />
            {site.contactCta.emailLabel}
          </ButtonLink>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
