---
import { site } from '../data/site';
import SeoHead from '../components/common/SeoHead.astro';
import SkipLink from '../components/common/SkipLink.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image,
  canonicalUrl,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  jsonLd,
} = Astro.props;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  description: site.description,
  url: site.siteUrl,
  sameAs: [site.social.github, site.social.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Fonts: Space Grotesk for display headings -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Notes`}
      href="/rss.xml"
    />
    <SeoHead
      title={title}
      description={description}
      image={image}
      canonicalUrl={canonicalUrl}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    {!jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(personJsonLd)}
      />
    )}
    <!-- Theme initialization to prevent flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = stored || preferred;
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body
    class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text-primary)] font-[var(--font-sans)] antialiased transition-colors duration-200"
  >
    <!-- Global Decorative Background -->
    <div class="fixed inset-0 z-[-1] pointer-events-none overflow-hidden">
      <!-- Subtle dot grid with fade-out mask -->
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+CgkJPGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMTMsIDE0OCwgMTM2LCAwLjE1KSIvPgoJPC9zdmc+')] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)] dark:opacity-40"></div>
      
      <!-- Ambient Glows -->
      <div class="absolute -top-[20%] -left-[10%] w-[50vw] h-[50vw] max-w-[800px] max-h-[800px] rounded-full bg-[var(--color-accent)]/10 blur-[100px] dark:blur-[120px]"></div>
      <div class="absolute top-[40%] -right-[10%] w-[40vw] h-[40vw] max-w-[600px] max-h-[600px] rounded-full bg-[var(--color-accent)]/5 blur-[80px] dark:blur-[100px]"></div>
    </div>
    
    <SkipLink />
    <SiteHeader />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <!-- Global scroll animation observer -->
    <script>
      function initScrollAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.animate-on-scroll, .stagger-children').forEach((el) => {
          observer.observe(el);
        });
      }

      initScrollAnimations();
      document.addEventListener('astro:after-swap', initScrollAnimations);
    </script>
  </body>
</html>
